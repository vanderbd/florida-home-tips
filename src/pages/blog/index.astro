---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import { getCollection } from 'astro:content';

const PAGE_SIZE = 9;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const page1Posts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);

const categories = [
  { label: 'Mold & Humidity',      emoji: '🦠' },
  { label: 'Hurricane Prep',        emoji: '🌪' },
  { label: 'Pests',                 emoji: '🐜' },
  { label: 'Exterior Maintenance',  emoji: '🏠' },
  { label: 'DIY Fixes',             emoji: '🔧' },
];
---

<BaseLayout
  title="Blog — Florida Home Tips"
  description="Browse all Florida home maintenance guides covering mold prevention, hurricane prep, pest control, exterior maintenance, and DIY fixes."
>
  <BreadcrumbSchema
    crumbs={[
      { name: 'Home', url: new URL('/', Astro.site).toString() },
      { name: 'Blog', url: new URL('/blog', Astro.site).toString() },
    ]}
  />

  <!-- Page header -->
  <div class="bg-dark-blue py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-montserrat text-cyan text-sm font-semibold uppercase tracking-widest mb-3">
        All Guides
      </p>
      <h1 class="font-montserrat font-extrabold text-3xl md:text-5xl text-white">
        Florida Home Tips Blog
      </h1>
      <p class="text-white/70 mt-3 text-base md:text-lg max-w-2xl">
        Practical, Florida-specific guides for every homeowner.
      </p>
    </div>
  </div>

  <!-- Filter + grid -->
  <section class="bg-gray-50 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Category filter -->
      <div
        class="flex flex-wrap gap-2 mb-10"
        role="group"
        aria-label="Filter posts by category"
      >
        <button
          data-filter="all"
          class="filter-btn active px-4 py-2 rounded-full text-sm font-montserrat font-semibold border transition-colors bg-cyan text-dark-blue border-transparent"
        >
          All Topics
        </button>
        {categories.map(({ label, emoji }) => (
          <button
            data-filter={label}
            class="filter-btn px-4 py-2 rounded-full text-sm font-montserrat font-semibold border transition-colors bg-white text-gray-600 border-gray-200 hover:border-cyan hover:text-vivid-cyan"
          >
            {emoji} {label}
          </button>
        ))}
      </div>

      <!-- Post grid -->
      <div
        id="post-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        {page1Posts.map((post) => (
          <div data-category={post.data.category}>
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              image={post.data.image}
              slug={post.id}
            />
          </div>
        ))}
      </div>

      <!-- Empty state (shown by JS when no posts match filter) -->
      <div id="no-results" class="hidden text-center py-16">
        <p class="text-gray-400 font-montserrat font-semibold text-lg">
          No posts in this category yet.
        </p>
        <p class="text-gray-400 text-sm mt-2">
          Check back soon — we're adding new guides regularly.
        </p>
      </div>

      <!-- Pagination (only shown when > 1 page) -->
      {totalPages > 1 && (
        <nav
          class="mt-12 flex items-center justify-center gap-3"
          aria-label="Blog pagination"
        >
          <span
            aria-current="page"
            class="px-4 py-2 rounded-lg bg-cyan text-dark-blue font-montserrat font-semibold text-sm"
          >
            1
          </span>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((p) => (
            <a
              href={`/blog/${p}`}
              class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-dark-blue font-montserrat font-semibold text-sm hover:border-cyan hover:text-vivid-cyan transition-colors"
            >
              {p}
            </a>
          ))}
          <a
            href="/blog/2"
            class="px-4 py-2 rounded-lg bg-white border border-gray-200 text-dark-blue font-montserrat font-semibold text-sm hover:border-cyan hover:text-vivid-cyan transition-colors"
          >
            Next →
          </a>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards   = document.querySelectorAll<HTMLElement>('[data-category]');
  const noResults = document.getElementById('no-results');

  const activeClasses   = ['bg-cyan', 'text-dark-blue', 'border-transparent'];
  const inactiveClasses = ['bg-white', 'text-gray-600', 'border-gray-200'];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });
      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      noResults?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
