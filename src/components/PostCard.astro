---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  image?: string;
  slug: string;
}

const { title, description, pubDate, category, image, slug } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col hover:-translate-y-1 hover:shadow-lg transition-all duration-200">

  <!-- Image / placeholder -->
  <a href={`/blog/${slug}`} class="block aspect-video overflow-hidden bg-gradient-to-br from-dark-blue to-brand-blue flex-shrink-0" tabindex="-1" aria-hidden="true">
    {image ? (
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full h-full" />
    )}
  </a>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <span class="inline-block text-xs font-montserrat font-semibold uppercase tracking-wider text-vivid-cyan mb-3">
      {category}
    </span>
    <h3 class="font-montserrat font-bold text-lg text-dark-blue mb-2 group-hover:text-brand-blue transition-colors leading-snug flex-1">
      <a href={`/blog/${slug}`} class="hover:underline decoration-brand-blue/30 underline-offset-2">
        {title}
      </a>
    </h3>
    <p class="text-gray-500 text-sm leading-relaxed mb-4 line-clamp-2">
      {description}
    </p>
    <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
      <time
        datetime={pubDate.toISOString()}
        class="text-xs text-gray-400"
      >
        {formattedDate}
      </time>
      <a
        href={`/blog/${slug}`}
        class="text-vivid-cyan text-sm font-medium font-montserrat hover:text-brand-blue transition-colors"
      >
        Read more →
      </a>
    </div>
  </div>
</article>
