---
interface Props {
  emoji: string;
  title: string;
  description: string;
  href: string;
}

const { emoji, title, description, href } = Astro.props;
---

<a
  href={href}
  class="group block bg-white rounded-xl p-6 shadow-sm border border-gray-100 hover:-translate-y-1 hover:shadow-lg hover:border-cyan/30 transition-all duration-200 text-center"
>
  <div class="text-4xl mb-3 select-none" aria-hidden="true">{emoji}</div>
  <h3 class="font-montserrat font-bold text-dark-blue text-base mb-2 group-hover:text-brand-blue transition-colors leading-snug">
    {title}
  </h3>
  <p class="text-gray-500 text-xs leading-relaxed">
    {description}
  </p>
</a>
