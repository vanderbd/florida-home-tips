---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/',            label: 'Home',        exact: true  },
  { href: '/blog',        label: 'Blog',        exact: false },
  { href: '/recommended', label: 'Recommended', exact: false },
  { href: '/checklist',   label: 'Checklist',   exact: false },
  { href: '/about',       label: 'About',       exact: false },
];

function isActive(href: string, exact: boolean): boolean {
  if (exact) return pathname === href || pathname === href + '/';
  return pathname.startsWith(href);
}
---

<header class="bg-dark-blue text-white sticky top-0 z-50 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="Florida Home Tips — Home">
        <img
          src="/images/logo/horizontal-light.svg"
          alt="Florida Home Tips"
          class="h-10 md:h-14 w-auto"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(({ href, label, exact }) => (
          <a
            href={href}
            class:list={[
              'px-3 py-2 rounded-md text-sm font-medium transition-colors',
              isActive(href, exact)
                ? 'text-cyan bg-white/10'
                : 'text-white/80 hover:text-cyan hover:bg-white/5',
            ]}
            aria-current={isActive(href, exact) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <a
        href="/checklist"
        class="hidden md:inline-flex items-center px-4 py-2 bg-cyan text-dark-blue font-montserrat font-semibold text-sm rounded-lg hover:bg-vivid-cyan transition-colors"
      >
        Free Checklist
      </a>

      <!-- Mobile Hamburger -->
      <button
        id="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation menu"
        class="md:hidden p-2 rounded-md text-white hover:text-cyan hover:bg-white/10 transition-colors"
      >
        <!-- Hamburger icon -->
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <!-- Close icon -->
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6 hidden"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <nav
    id="mobile-nav"
    class="hidden md:hidden bg-dark-blue border-t border-white/10"
    aria-label="Mobile navigation"
  >
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      {navLinks.map(({ href, label, exact }) => (
        <a
          href={href}
          class:list={[
            'px-3 py-2 rounded-md text-sm font-medium transition-colors',
            isActive(href, exact)
              ? 'text-cyan bg-white/10'
              : 'text-white/80 hover:text-cyan hover:bg-white/5',
          ]}
          aria-current={isActive(href, exact) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <div class="pt-3 mt-1 border-t border-white/10">
        <a
          href="/checklist"
          class="block text-center px-4 py-2 bg-cyan text-dark-blue font-montserrat font-semibold text-sm rounded-lg hover:bg-vivid-cyan transition-colors"
        >
          Free Florida Home Checklist
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const nav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    if (!nav || !iconOpen || !iconClose || !btn) return;
    const isNowHidden = nav.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isNowHidden));
    btn.setAttribute('aria-label', isNowHidden ? 'Open navigation menu' : 'Close navigation menu');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  });
</script>
