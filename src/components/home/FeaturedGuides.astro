---
import { getCollection } from 'astro:content';
import PostCard from '../PostCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.featured);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

{posts.length > 0 && (
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-10 gap-4">
        <div>
          <p class="font-montserrat font-semibold text-sm uppercase tracking-wider text-vivid-cyan mb-2">
            Handpicked for You
          </p>
          <h2 class="font-montserrat font-bold text-3xl md:text-4xl text-dark-blue">
            Featured Guides
          </h2>
        </div>
        <a
          href="/blog"
          class="font-montserrat font-semibold text-sm text-vivid-cyan hover:text-brand-blue transition-colors flex-shrink-0"
        >
          View all guides →
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            image={post.data.image}
            slug={post.id}
          />
        ))}
      </div>
    </div>
  </section>
)}
